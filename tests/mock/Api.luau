-- Compact Roblox API database (generated by tools/gen_api_db.py from the official API dump).
-- Used by the mock runtime to reject members that do not exist in the real engine.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local Api = {}

local raw
local resolved = {}

local function load()
	if raw then
		return raw
	end
	local here = debug.info(1, "s")
	local dir = string.match(here, "^(.*)[/\\][^/\\]+$") or "."
	dir = string.gsub(dir, '^%[string "(.*)"%]$', "%1")
	local candidates = { dir .. "/api.json.gz", "tests/mock/api.json.gz" }
	for _, path in candidates do
		if fs.isFile(path) then
			raw = serde.decode("json", serde.decompress("gzip", fs.readFile(path)))
			return raw
		end
	end
	error("api.json.gz not found (run tools/gen_api_db.py)")
end

export type MemberKind = "Property" | "Event" | "Function" | "Callback"

function Api.class(name: string)
	local cached = resolved[name]
	if cached then
		return cached
	end
	local data = load()
	local cls = data.classes[name]
	if not cls then
		return nil
	end
	local info = {
		name = name,
		superclass = cls.s,
		isService = table.find(cls.t, "Service") ~= nil,
		notCreatable = table.find(cls.t, "NotCreatable") ~= nil,
		props = {},
		events = {},
		functions = {},
		callbacks = {},
		ancestors = { [name] = true },
	}
	if cls.s ~= "" and cls.s ~= "<<<ROOT>>>" then
		local parent = Api.class(cls.s)
		if parent then
			for k, v in parent.props do
				info.props[k] = v
			end
			for k in parent.events do
				info.events[k] = true
			end
			for k in parent.functions do
				info.functions[k] = true
			end
			for k in parent.callbacks do
				info.callbacks[k] = true
			end
			for k in parent.ancestors do
				info.ancestors[k] = true
			end
		end
	end
	for propName, prop in cls.p do
		info.props[propName] = { category = prop[1], typeName = prop[2], readonly = prop[3] == 1 }
	end
	for _, eventName in cls.e do
		info.events[eventName] = true
	end
	for _, functionName in cls.f do
		info.functions[functionName] = true
	end
	for _, callbackName in cls.c do
		info.callbacks[callbackName] = true
	end
	resolved[name] = info
	return info
end

function Api.isA(className: string, target: string): boolean
	local info = Api.class(className)
	return info ~= nil and info.ancestors[target] == true
end

function Api.enumItems(enumName: string)
	return load().enums[enumName]
end

function Api.version()
	return load().version
end

return Api
